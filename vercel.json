{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.sarabjeetrattan.com"
        }
      ],
      "destination": "https://sarabjeetrattan.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|images/|fonts/|favicon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}

